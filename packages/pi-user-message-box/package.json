{
  "name": "@vimsucks/pi-user-message-box",
  "version": "0.1.0",
  "description": "Render Pi user messages in a bordered, theme-aware box without changing tools or model context.",
  "packageManager": "pnpm@12.12.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/vimsucks/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/vimsucks/pi-extensions/issues"
  },
  "type": "module",
  "license": "MIT",
  "author": "vimsucks <dev@vimsucks.com>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "tui",
    "user-message"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimsucks/pi-extensions.git",
    "directory": "packages/pi-user-message-box"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
